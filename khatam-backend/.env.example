# Copier en .env et adapter avant déploiement en production.

# Dev (SQLite, aucune installation requise) :
DATABASE_URL="file:./dev.db"

# Production (exemple PostgreSQL, ex. Render/Railway) :
# DATABASE_URL="postgresql://user:password@host:5432/khatam?schema=public"
# -> et changer provider = "postgresql" dans prisma/schema.prisma

JWT_SECRET="change-me-to-a-long-random-secret"
PORT=4000
BOOST_PRICE_MRU=500
BOOST_DURATION_DAYS=30

# Passerelles de paiement (voir src/lib/payments.js) — à remplir avec les
# identifiants marchands réels une fois les contrats signés avec chaque opérateur.
BANKILY_API_KEY=
BANKILY_MERCHANT_ID=
MASRIVI_API_KEY=
MASRIVI_MERCHANT_ID=
SEDAD_API_KEY=
SEDAD_MERCHANT_ID=
